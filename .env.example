# Biến môi trường mẫu — copy thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chỉ dùng phía server (seed, admin). Không bao giờ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Múi giờ mặc định để tính "ngày" nhật ký
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
